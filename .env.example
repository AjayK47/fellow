# Definitive SQLite database
DOCKET_HOST=127.0.0.1
DOCKET_PORT=8080
DOCKET_DATA_DIR=data
DOCKET_DB_NAME=brain.db
DOCKET_DEFAULT_ORG_ID=org_acme
DOCKET_LOG_LEVEL=info

# Deterministic is local/offline. Use openrouter for live inference.
# The chat model and the embedding model are configured independently —
# each has its own API key/base URL/model so they can point at different
# providers (e.g. OpenRouter for chat, a dedicated embeddings host).
DOCKET_MODEL_API_KEY=
DOCKET_MODEL_PROVIDER=deterministic
DOCKET_MODEL_BASE_URL=https://openrouter.ai/api/v1
DOCKET_CHAT_MODEL=openai/gpt-5.6-luna
DOCKET_ATTENTION_MODEL=openai/gpt-5.6-luna
DOCKET_EXTRACTION_MODEL=openai/gpt-5.6-luna

DOCKET_EMBEDDING_API_KEY=
DOCKET_EMBEDDING_PROVIDER=deterministic
DOCKET_EMBEDDING_MODEL=qwen/qwen3-embedding-8b
DOCKET_EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
DOCKET_EMBEDDING_DIMENSIONS=96
# Optional general-web research tools. Search requires a Brave Search API key;
# fetch reads public pages directly and is enabled by default.
BRAVE_SEARCH_API_KEY=
FIRECRAWL_API_KEY=
DOCKET_WEB_FETCH_ENABLED=true
DOCKET_MODEL_TIMEOUT_SECONDS=90
DOCKET_AGENT_MAX_ITERATIONS=50
DOCKET_AGENT_MAX_TOOL_CALLS=100
DOCKET_AGENT_CONTEXT_TOKEN_BUDGET=12000
DOCKET_AGENT_MAX_TOTAL_TOKENS=100000
DOCKET_CHILD_TASK_MAX_PARALLEL=3
DOCKET_CHILD_TASK_MAX_DEPTH=1
DOCKET_CHILD_AGENT_MAX_ITERATIONS=200
DOCKET_CHILD_AGENT_MAX_TOOL_CALLS=500
OPENROUTER_API_KEY=

# Slack Events API / Socket Mode
DOCKET_SLACK_SIGNING_SECRET=
DOCKET_SLACK_BOT_TOKEN=
DOCKET_SLACK_APP_TOKEN=
DOCKET_SLACK_BOT_USER_ID=
DOCKET_SLACK_REQUIRE_MENTION=true
DOCKET_SLACK_THREAD_REQUIRE_MENTION=false
DOCKET_SLACK_FREE_RESPONSE_CHANNELS=
DOCKET_SLACK_ALLOWED_CHANNELS=
DOCKET_SLACK_PROACTIVE_CHANNELS=
DOCKET_SLACK_SIGNATURE_TOLERANCE_SECONDS=300

# Composio v3.1
DOCKET_COMPOSIO_API_KEY=
DOCKET_COMPOSIO_BASE_URL=https://backend.composio.dev/api/v3.1
DOCKET_COMPOSIO_CONNECTED_ACCOUNT_ID=
DOCKET_COMPOSIO_TOOLKIT_VERSIONS=latest
DOCKET_COMPOSIO_WEBHOOK_SECRET=
DOCKET_COMPOSIO_WEBHOOK_TOLERANCE_SECONDS=300

# Public URL for this gateway (e.g. an ngrok tunnel to localhost:8080).
# When set alongside DOCKET_COMPOSIO_API_KEY, the gateway registers
# {DOCKET_PUBLIC_URL}/v1/composio/webhooks with Composio on startup and
# fetches the webhook secret automatically — no manual dashboard step.
DOCKET_PUBLIC_URL=

# Durable worker and proactive policy
DOCKET_WORKER_ENABLED=true
DOCKET_WORKER_POLL_INTERVAL_SECONDS=0.5
DOCKET_WORKER_LEASE_SECONDS=60
DOCKET_WORKER_BATCH_SIZE=20
DOCKET_WORKER_CONCURRENCY=4
DOCKET_ATTENTION_MINIMUM_CONFIDENCE=0.72
DOCKET_PROACTIVE_COOLDOWN_SECONDS=900
DOCKET_EPISODE_QUIET_SECONDS=300
