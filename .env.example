# Definitive SQLite database
COMPANY_BRAIN_HOST=127.0.0.1
COMPANY_BRAIN_PORT=8080
COMPANY_BRAIN_DATA_DIR=data
COMPANY_BRAIN_DB_NAME=brain.db
COMPANY_BRAIN_DEFAULT_ORG_ID=org_acme
COMPANY_BRAIN_LOG_LEVEL=info

# Deterministic is local/offline. Use openrouter for live inference.
COMPANY_BRAIN_EMBEDDING_PROVIDER=deterministic
COMPANY_BRAIN_EMBEDDING_MODEL=qwen/qwen3-embedding-8b
COMPANY_BRAIN_EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
COMPANY_BRAIN_EMBEDDING_DIMENSIONS=96
COMPANY_BRAIN_MODEL_PROVIDER=deterministic
COMPANY_BRAIN_CHAT_MODEL=openai/gpt-4.1-mini
COMPANY_BRAIN_ATTENTION_MODEL=openai/gpt-4.1-mini
COMPANY_BRAIN_EXTRACTION_MODEL=openai/gpt-4.1-mini
COMPANY_BRAIN_MODEL_BASE_URL=https://openrouter.ai/api/v1
COMPANY_BRAIN_MODEL_TIMEOUT_SECONDS=90
COMPANY_BRAIN_AGENT_MAX_ITERATIONS=12
COMPANY_BRAIN_AGENT_MAX_TOOL_CALLS=24
COMPANY_BRAIN_AGENT_CONTEXT_TOKEN_BUDGET=12000
COMPANY_BRAIN_AGENT_MAX_TOTAL_TOKENS=100000
COMPANY_BRAIN_SPECIALIST_MAX_PARALLEL=3
COMPANY_BRAIN_SPECIALIST_MAX_DEPTH=1
OPENROUTER_API_KEY=

# Slack Events API / Socket Mode
COMPANY_BRAIN_SLACK_SIGNING_SECRET=
COMPANY_BRAIN_SLACK_BOT_TOKEN=
COMPANY_BRAIN_SLACK_APP_TOKEN=
COMPANY_BRAIN_SLACK_BOT_USER_ID=
COMPANY_BRAIN_SLACK_REQUIRE_MENTION=true
COMPANY_BRAIN_SLACK_THREAD_REQUIRE_MENTION=false
COMPANY_BRAIN_SLACK_FREE_RESPONSE_CHANNELS=
COMPANY_BRAIN_SLACK_ALLOWED_CHANNELS=
COMPANY_BRAIN_SLACK_PROACTIVE_CHANNELS=
COMPANY_BRAIN_SLACK_SIGNATURE_TOLERANCE_SECONDS=300

# Composio v3.1
COMPANY_BRAIN_COMPOSIO_API_KEY=
COMPANY_BRAIN_COMPOSIO_BASE_URL=https://backend.composio.dev/api/v3.1
COMPANY_BRAIN_COMPOSIO_CONNECTED_ACCOUNT_ID=
COMPANY_BRAIN_COMPOSIO_TOOLKIT_VERSIONS=latest
COMPANY_BRAIN_COMPOSIO_WEBHOOK_SECRET=
COMPANY_BRAIN_COMPOSIO_WEBHOOK_TOLERANCE_SECONDS=300

# Durable worker and proactive policy
COMPANY_BRAIN_WORKER_ENABLED=true
COMPANY_BRAIN_WORKER_POLL_INTERVAL_SECONDS=0.5
COMPANY_BRAIN_WORKER_LEASE_SECONDS=60
COMPANY_BRAIN_WORKER_BATCH_SIZE=20
COMPANY_BRAIN_WORKER_CONCURRENCY=4
COMPANY_BRAIN_ATTENTION_MINIMUM_CONFIDENCE=0.72
COMPANY_BRAIN_PROACTIVE_COOLDOWN_SECONDS=900
COMPANY_BRAIN_EPISODE_QUIET_SECONDS=300
