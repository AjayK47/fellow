# Definitive SQLite database
TODA_HOST=127.0.0.1
TODA_PORT=8080
TODA_DATA_DIR=data
TODA_WORKSPACE_ROOT=data/workspaces
TODA_DB_NAME=brain.db
TODA_DEFAULT_ORG_ID=org_acme
TODA_LOG_LEVEL=info
# Required for non-local POST /v1/events and /v1/events:batch callers.
# Supply one or more strong tokens separated by commas.
TODA_API_KEYS=

# Provider credentials are stored once per named connection. Model roles
# reference those connections. Keep both as compact JSON on one line.
# Empty objects select Toda's deterministic offline models.
TODA_PROVIDER_CONNECTIONS={}
TODA_MODEL_ASSIGNMENTS={}
TODA_MAIN_MODEL_REASONING_EFFORT=medium
TODA_EMBEDDING_DIMENSIONS=96

# Web providers are separate from inference providers. Search and extraction
# can be assigned independently (Brave/Tavily/Exa/Firecrawl/SearXNG).
TODA_TOOL_CONNECTIONS={}
TODA_WEB_SEARCH_CONNECTION=
TODA_WEB_EXTRACT_CONNECTION=
TODA_WEB_FETCH_ENABLED=true
TODA_WEB_FETCH_MAX_CHARS=18000
TODA_MODEL_TIMEOUT_SECONDS=600
TODA_AGENT_MAX_ITERATIONS=50
TODA_AGENT_MAX_TOOL_CALLS=100
TODA_AGENT_CONTEXT_TOKEN_BUDGET=200000
TODA_AGENT_MAX_TOTAL_TOKENS=2000000
TODA_AGENT_COMPLETION_MAX_TOKENS=40000
TODA_CHILD_TASK_MAX_PARALLEL=3
TODA_CHILD_TASK_MAX_DEPTH=1
TODA_CHILD_AGENT_MAX_ITERATIONS=200
TODA_CHILD_AGENT_MAX_TOOL_CALLS=500
TODA_SESSION_MANAGER_LEASE_SECONDS=3600
TODA_TASK_EXECUTION_LEASE_SECONDS=3600

# Model-generated Python execution is approval-gated but runs locally. Disable
# it when processing untrusted content unless an OS-level sandbox is supplied.
TODA_RUN_CODE_ENABLED=false
TODA_RUN_CODE_TIMEOUT_SECONDS=900
TODA_RUN_CODE_MAX_TOOL_CALLS=100

# Full-trust Pi coding children are separate and disabled by default.
TODA_PI_CODING_ENABLED=false
TODA_PI_CHECKPOINT_INTERVAL_SECONDS=3600
TODA_PI_STALE_HEARTBEAT_SECONDS=1800
TODA_PI_POLL_INTERVAL_SECONDS=10
TODA_PI_CANCEL_GRACE_SECONDS=20
# Browser and media models use roles in TODA_MODEL_ASSIGNMENTS: vision,
# image, transcription, and tts. They reuse their connection credential.
TODA_BROWSER_ENABLED=false
TODA_BROWSER_ALLOWED_DOMAINS=
TODA_BROWSER_CDP_ENABLED=false

TODA_MAIN_MODEL_SUPPORTS_VISION=false
TODA_TRANSCRIPTION_LANGUAGE=
TODA_TTS_VOICE=default
TODA_TTS_FORMAT=mp3
TODA_MEDIA_MAX_BYTES=26214400

# Slack Events API / Socket Mode
TODA_SLACK_SIGNING_SECRET=
TODA_SLACK_BOT_TOKEN=
TODA_SLACK_APP_TOKEN=
TODA_SLACK_BOT_USER_ID=
TODA_SLACK_CLIENT_ID=
TODA_SLACK_CLIENT_SECRET=
TODA_SLACK_REQUIRE_MENTION=true
TODA_SLACK_FREE_RESPONSE_CHANNELS=
TODA_SLACK_ALLOWED_CHANNELS=
TODA_SLACK_PROACTIVE_CHANNELS=
TODA_SLACK_SIGNATURE_TOLERANCE_SECONDS=300
TODA_SLACK_OAUTH_SCOPES=app_mentions:read,channels:history,channels:read,chat:write,groups:history,groups:read,im:history,mpim:history,mpim:read,reactions:write,users:read,users:read.email,files:read,files:write
# Distributed Slack installs must include files:read for voice ingestion.

# Composio v3.1
TODA_COMPOSIO_API_KEY=
TODA_COMPOSIO_BASE_URL=https://backend.composio.dev/api/v3.1
TODA_COMPOSIO_CONNECTED_ACCOUNT_ID=
TODA_COMPOSIO_TOOLKIT_VERSIONS=latest
TODA_COMPOSIO_WEBHOOK_SECRET=
TODA_COMPOSIO_WEBHOOK_TOLERANCE_SECONDS=300

# Public URL for this gateway (e.g. an ngrok tunnel to localhost:8080).
# When set alongside TODA_COMPOSIO_API_KEY, the gateway registers
# {TODA_PUBLIC_URL}/v1/composio/webhooks with Composio on startup and
# fetches the webhook secret automatically — no manual dashboard step.
TODA_PUBLIC_URL=

# Local console login and development-only write behavior.
TODA_DASHBOARD_SESSION_SECRET=
TODA_DASHBOARD_AUTH_DISABLED=false
# Generated by `python scripts/bootstrap.py`; exchanged for a signed console
# session cookie and suitable for self-hosted installs without Slack OAuth.
TODA_LOCAL_ADMIN_TOKEN=
TODA_AUTO_APPROVE_WRITES=false

# Durable worker and proactive policy
TODA_WORKER_ENABLED=true
TODA_WORKER_POLL_INTERVAL_SECONDS=0.5
TODA_WORKER_LEASE_SECONDS=60
TODA_WORKER_BATCH_SIZE=20
TODA_WORKER_CONCURRENCY=30
TODA_WORKER_KNOWLEDGE_CONCURRENCY=8
TODA_ATTENTION_MINIMUM_CONFIDENCE=0.72
TODA_PROACTIVE_COOLDOWN_SECONDS=900
TODA_EPISODE_QUIET_SECONDS=300
TODA_DISPATCHER_TICK_INTERVAL_SECONDS=30
