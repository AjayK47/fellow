# Configuration and secrets. config.json is the only config file Toda
# reads; config.example.json is the tracked, redacted template.
config.json
!config.example.json
# Toda no longer reads .env, but stray ones still turn up in a working
# tree and hold real credentials. Keep ignoring them so an `add -A` can
# never sweep one into a commit.
.env
.env.*

# Python tooling caches and build artifacts
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Web console build outputs (React + Vite under web/)
web/node_modules/
web/dist/
web/*.tsbuildinfo
src/toda/static/console/

# macOS
.DS_Store
node_modules/

# Toda runtime state and local operator material
data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Private research/reference worktrees and generated product experiments
harnesses/
old/
build/
dist/
imgs/
landing/
site/
--help

# Private implementation notes are not part of the community distribution
*_PLAN.md
*_HANDOFF.md
*_TODO.md
*ANALYSIS*.md
HARNESS_*.md
*_HARNESS_UNDERSTANDING.md
IMPLEMENTATION_STATUS.md
CLAUDE.md
.claude/
.commandcode/

# Eval corpora and results. The generator, cases and scorers are tracked;
# the generated organization and every run's scores are not -- corpora are
# model-written and large, and results are per-machine.
evals/data/
evals/results/
