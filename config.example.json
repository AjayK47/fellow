{
  "server": {
    "host": "127.0.0.1",
    "port": 8080,
    "log_level": "info",
    "public_url": "https://vastly-concise-hamster.ngrok-free.app",
    "api_keys": []
  },
  "organization": {
    "id": "org_acme",
    "name": "Acme",
    "owner_email": "you@example.com"
  },
  "storage": {
    "data_dir": "~/.local/share/toda",
    "db_name": "brain.db",
    "workspace_root": "~/.local/share/toda/workspaces",
    "agent_workspace_root": "~/.local/share/toda-agent-workspaces"
  },
  "models": {
    "providers": {
      "concentrate": {
        "provider": "concentrate",
        "api_key": "<your-concentrate-key>",
        "base_url": null
      },
      "openrouter": {
        "provider": "openrouter",
        "api_key": "<your-openrouter-key>",
        "base_url": null
      },
      "local": {
        "provider": "local",
        "api_key": null,
        "base_url": null
      }
    },
    "assignments": {
      "main": {
        "connection": "concentrate",
        "model": "auto"
      },
      "attention": {
        "connection": "concentrate",
        "model": "auto"
      },
      "extraction": {
        "connection": "concentrate",
        "model": "auto"
      },
      "embedding": {
        "connection": "local",
        "model": "BAAI/bge-small-en-v1.5"
      }
    },
    "embedding_dimensions": 384,
    "timeout_seconds": 600.0,
    "catalog_enabled": true,
    "catalog_url": "https://models.dev/catalog.json",
    "catalog_refresh_interval_seconds": 86400,
    "catalog_timeout_seconds": 5.0,
    "main_reasoning_effort": "medium",
    "main_supports_vision": false
  },
  "slack": {
    "signing_secret": "<your-api-key>",
    "bot_token": "<your-api-key>",
    "app_token": "<your-api-key>",
    "bot_user_id": "U0BMF6BL20J",
    "require_mention": true,
    "free_response_channels": [],
    "allowed_channels": [],
    "proactive_channels": [],
    "signature_tolerance_seconds": 300
  },
  "composio": {
    "api_key": "<your-api-key>",
    "base_url": "https://backend.composio.dev/api/v3.1",
    "connected_account_id": null,
    "toolkit_versions": "latest",
    "webhook_secret": null,
    "webhook_tolerance_seconds": 300
  },
  "tools": {
    "connections": {
      "brave": {
        "provider": "brave",
        "api_key": "<your-api-key>",
        "base_url": null
      },
      "firecrawl": {
        "provider": "firecrawl",
        "api_key": "<your-api-key>",
        "base_url": null
      }
    },
    "web_search_connection": "brave",
    "web_extract_connection": "firecrawl",
    "web_fetch_enabled": true,
    "web_fetch_max_chars": 18000,
    "run_code_enabled": false,
    "run_code_timeout_seconds": 900,
    "run_code_max_tool_calls": 100,
    "browser_enabled": false,
    "browser_allowed_domains": [],
    "browser_cdp_enabled": false
  },
  "media": {
    "transcription_language": null,
    "tts_voice": "default",
    "tts_format": "mp3",
    "max_bytes": 26214400
  },
  "agent": {
    "persona_name": "Toda",
    "require_real_world_readiness": true,
    "max_duration_seconds": 3600,
    "max_model_calls": 100,
    "max_cost_usd": 10.0,
    "pi_coding_enabled": false,
    "pi_provider": null,
    "pi_model": null,
    "pi_credential_env": "OPENROUTER_API_KEY",
    "pi_credential_connection": "openrouter",
    "pi_execution_user": null,
    "pi_isolation_required": true,
    "pi_home": null,
    "pi_cpu_seconds": 3600,
    "pi_max_processes": 256,
    "pi_max_file_bytes": 50000000,
    "pi_memory_bytes": null,
    "pi_workspace_retention_hours": 24
  },
  "observability": {
    "enabled": true,
    "service_name": "toda",
    "environment": "development",
    "otlp_endpoint": null,
    "otlp_headers": {},
    "export_timeout_seconds": 10.0,
    "capture_payloads": false,
    "max_payload_bytes": 100000,
    "retention_days": 7,
    "sample_ratio": 1.0,
    "console_export": false
  }
}
